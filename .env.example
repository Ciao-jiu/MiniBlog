# 示例配置，仅供参考。项目不会自动加载 .env 文件，请将变量设置到当前终端环境。

# 本地开发数据库。请按本机 MySQL 用户名和密码修改。
MINIBLOG_DB_DSN=root:change_me@tcp(127.0.0.1:3306)/miniblog?charset=utf8mb4&parseTime=True&loc=Local

# 本地开发 Redis
MINIBLOG_REDIS_ADDR=127.0.0.1:6379

# 本地开发 JWT 签名密钥；请替换为随机字符串，不要用于生产环境。
MINIBLOG_JWT_SECRET=replace-with-a-long-random-secret

# 集成测试必须使用独立数据库；测试初始化会清理 users 和 articles 表。
MINIBLOG_TEST_DB_DSN=root:change_me@tcp(127.0.0.1:3306)/miniblog_test?charset=utf8mb4&parseTime=True&loc=Local

# 集成测试会对连接的 Redis 执行 FLUSHDB，务必使用可清空的测试实例/数据库。
MINIBLOG_TEST_REDIS_ADDR=127.0.0.1:6379
